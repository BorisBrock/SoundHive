{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundHive",
  "version": "0.1.0",
  "identifier": "dev.soundhive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundHive",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Find, audition and use sound effects fast",
    "longDescription": "SoundHive indexes your sound effect folders, tags and analyses every file, and lets you search, audition and drag sounds into your game and video projects.",
    "publisher": "Boris Brock",
    "copyright": "© 2026 Boris Brock",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
